> ### Name: correlated_sample
> ### Title: Generate a correlated sample
> ### Aliases: correlated_sample
> 
> ### ** Examples
> 
> R <- matrix(
+   c(1.0, 0.5,
+     0.5, 1.0),
+   nrow = 2,
+   byrow = TRUE
+ )
> 
> dat <- correlated_sample(N = 100, R = R, mu = c(0, 2), sd = c(1, 3))
